; RePrise — SFC 風 CTB ローグライク RPG
;
; 表示は 256x224（SFC の標準解像度）で作り、ウィンドウへは整数倍で引き伸ばす。
; ここを崩すとドットが不均一に潰れて一気に「SFC 風」でなくなるので、
; stretch/mode=viewport と texture_filter=nearest はセットで固定する。

config_version=5

[application]

config/name="RePrise"
; バージョンの原本はここ。タイトルバー（src/game/version.gd）も
; エクスポートした .exe のファイル情報も、この 1 か所を読む。
config/version="0.1.0"
run/main_scene="res://src/scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

; Database は静的クラスなのでオートロード不要（src/data/database.gd 参照）。
GameState="*res://src/game/game_state.gd"
Sound="*res://src/audio/audio_manager.gd"

[display]

; 512x320。もとは 384x240（後期 SFC 相当）だったが、日本語の漢字は 13px を
; 下回ると画数が潰れて読めず、384 幅では「読める文字」を並べると 1 行に入る
; 字数が足りなくなった。文字を優先して解像度を上げてある。
; タイル 16px / キャラ 24x32 は据え置きなので、絵の資産はそのまま使える。
; 画面比は 384x240 と同じ 16:10（4/3 倍）。
window/size/viewport_width=512
window/size/viewport_height=320
window/size/window_width_override=1536
window/size/window_height_override=960
window/stretch/mode="viewport"
window/stretch/aspect="keep"

[input]

; 方向キーは WASD でも動くようにする。ui_* を上書きすると既定の割り当ては
; 失われるので、矢印キーもここに明示して並べておくこと。
ui_up={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194320,"pressed":true),Object(InputEventKey,"physical_keycode":87,"pressed":true)]
}
ui_down={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194322,"pressed":true),Object(InputEventKey,"physical_keycode":83,"pressed":true)]
}
ui_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194319,"pressed":true),Object(InputEventKey,"physical_keycode":65,"pressed":true)]
}
ui_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194321,"pressed":true),Object(InputEventKey,"physical_keycode":68,"pressed":true)]
}

confirm={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":90,"pressed":true),Object(InputEventKey,"physical_keycode":4194309,"pressed":true),Object(InputEventKey,"physical_keycode":32,"pressed":true)]
}
cancel={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":88,"pressed":true),Object(InputEventKey,"physical_keycode":4194305,"pressed":true)]
}
auto={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":65,"pressed":true),Object(InputEventKey,"physical_keycode":4194325,"pressed":true)]
}

[rendering]

renderer/rendering_method="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
