shader_type canvas_item;

// 場面転換の覆い（B-3）。
//
// **アトラスは透明度で覆いを表している。** 測ると不透明の割合が
// コマ 1 の 44%（アイリス）／5%（画素）から、コマ 8 の 100% まで増える。
// つまり絵をそのまま重ねれば覆いになる ―― 加工は要らなかった。
//
// 一度、明るいところを「穴」とみなす輝度マスクを噛ませたが、銀の刃の
// ハイライトまで抜けて**刃の中に地形が透けて見えた**。やめた。
//
// 残してあるのは締めだけ。覆いきった一瞬が無いと、その裏で画面を
// 差し替えたのが見えてしまう。

/// 最後の締め。1 で全面を覆う。
uniform float seal : hint_range(0.0, 1.0) = 0.0;

void fragment() {
	vec4 c = texture(TEXTURE, UV);
	COLOR = vec4(c.rgb, max(c.a, seal));
}
