# Python
__pycache__/
*.pyc

# Godot
.godot/
/android/
*.translation

# 書き出したバイナリ。原本はソースなので追跡しない。
build/

# export_presets.cfg は逆に追跡する。無いと README のビルド手順が
# そのままでは動かないため（鍵やパスワードは書かないこと）。

# 生成物: 音声だけはサイズが大きいので追跡しない。
# 生成器（tools/gen_audio.py）が唯一の原本で、セットアップ時に作り直す。
# ドット絵は数 KB なので逆に追跡する（差分がレビューできる利点が勝る）。
assets/audio/**/*.wav

# 開発用の撮影物。ランごとに中身が変わるので基本は追跡しない。
# README が貼っている数枚だけは例外にする（追跡しないとリンクが壊れる）。
# .import は撮影物には不要（ゲームからは参照していない）。
docs/preview/screen_*.png
docs/preview/screen_*.png.import
!docs/preview/screen_battle.png
!docs/preview/screen_explore.png
!docs/preview/screen_stronghold.png
!docs/preview/screen_shop.png
!docs/preview/screen_upgrade.png
!docs/preview/screen_title.png

# 個人用の設定。共有するのは .claude/settings.json のほう。
.claude/settings.local.json

# OS
Thumbs.db
desktop.ini
